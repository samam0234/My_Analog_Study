{
  "name": "analog-board",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js",
    "start": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "preview": "node --env-file-if-exists=.env dist/analog/server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/sync-swagger.mjs",
    "prestart": "node scripts/sync-swagger.mjs",
    "predev": "node scripts/sync-swagger.mjs"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^3.0.0",
    "@analogjs/router": "^3.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@anthropic-ai/sdk": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "bullmq": "^6.7.10",
    "front-matter": "^4.0.2",
    "h3": "^1.15.11",
    "ioredis": "^5.11.1",
    "jose": "^6.2.18",
    "knex": "^3.3.0",
    "marked": "^18.0.0",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "mongodb": "^7.9.1",
    "mysql2": "^3.24.6",
    "nitropack": "^2.14.0",
    "nodemailer": "^10.6.1",
    "openid-client": "^6.9.1",
    "pg": "^8.23.1",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "stripe": "^23.2.0",
    "swagger-ui-dist": "^5.36.0",
    "tslib": "^2.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@analogjs/platform": "^3.0.0",
    "@analogjs/vite-plugin-angular": "^3.0.0",
    "@analogjs/vite-plugin-nitro": "^3.0.0",
    "@analogjs/vitest-angular": "^3.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "jsdom": "^22.0.0",
    "rollup": "^4.40.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
